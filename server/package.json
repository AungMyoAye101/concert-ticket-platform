{
  "name": "ticket",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only  src/index.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate ./src/migrations/Init -d ./src/lib/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d ./src/lib/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/lib/data-source.js",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d ./src/lib/data-source.ts",
    "seed": "ts-node src/lib/seed-data.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "yarn@1.22.19",
  "dependencies": {
    "compression": "^1.8.1",
    "@sentry/node": "^10.32.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "bcrypt": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pg": "^8.16.3",
    "rate-limit-redis": "^4.3.0",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
